# GitHub publication and intent interpretation are optional capabilities.
# Empty or whitespace-only values leave that capability absent.
# GITHUB_BASE_BRANCH=main is the default and does not by itself configure publication.
# A mixture of set and omitted variables in either group fails startup.
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_COMMIT_AUTHOR_NAME=
GITHUB_COMMIT_AUTHOR_EMAIL=
GITHUB_TOKEN=
GITHUB_BASE_BRANCH=main
IAC_AGENT_LLM_PROVIDER=
IAC_AGENT_LLM_MODEL=
OPENAI_API_KEY=
IAC_AGENT_OBSERVABILITY=off
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Mandatory local operator secret. No default. Blank or whitespace-only refuses startup.
# Runtime environment only. Not a sample value, not a frontend build variable.
IAC_AGENT_OPERATOR_SECRET=
IAC_AGENT_BIND_HOST=127.0.0.1
IAC_AGENT_PORT=8000
# Container overrides. Leave unset for local checkout behavior.
# IAC_AGENT_TRUSTED_MODULE_ROOT=/opt/iac-agent
# IAC_AGENT_STATE_DB=/var/lib/iac-agent/state/state.db
# IAC_AGENT_WORKSPACE_ROOT=/var/lib/iac-agent/workspaces
